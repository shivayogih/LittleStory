{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Read(./local.properties)",
      "Edit(./local.properties)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Edit(./keystore.properties)"
    ]
  }
}
