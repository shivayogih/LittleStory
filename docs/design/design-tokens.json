{
  "$description": "LittleStory design tokens, extracted from the compiled CSS of the Figma Make prototype 'Mobile App UI Prototype' (file 2DYtUW39GtnsDpUd5jSu6x).",
  "color": {
    "brand": {
      "indigo":        { "value": "#35256f", "role": "Primary: buttons, hero, active nav, links" },
      "indigo-2":      { "value": "#4b388b", "role": "Eyebrow labels" },
      "lavender":      { "value": "#a995f5", "role": "Accent: focus ring, progress, selected outline, dark-mode play button" },
      "soft-lavender": { "value": "#eae3ff", "role": "Secondary button, selected chip, active nav pill, icon tiles" }
    },
    "night": {
      "night":         { "value": "#17152f", "role": "Dark canvas: onboarding, player, generating, premium hero" },
      "night-surface": { "value": "#242044", "role": "Dark raised surface" }
    },
    "surface": {
      "cream":   { "value": "#fff9f0", "role": "App background" },
      "white":   { "value": "#ffffff", "role": "Cards, inputs" },
      "surface": { "value": "#f8f5fb", "role": "Segmented control track" },
      "line":    { "value": "#e9e4ec", "role": "Borders, dividers" },
      "page-backdrop": { "value": "#e8e5ed", "role": "Body background outside the 430px shell" }
    },
    "accent": {
      "yellow": { "value": "#ffd977", "role": "Stars, moon, kicker text on dark, progress gradient end" },
      "peach":  { "value": "#ffc9ad", "role": "Lesson icon tile, hero book edge" },
      "moon":   { "value": "#fff1bd", "role": "Crescent moon fill" }
    },
    "text": {
      "text":  { "value": "#25213a", "role": "Primary text" },
      "muted": { "value": "#716b80", "role": "Secondary text" },
      "reader-body": { "value": "#393348", "role": "Story paragraph text" },
      "nav-inactive": { "value": "#817b8d", "role": "Inactive bottom-nav items" }
    },
    "semantic": {
      "success":    { "value": "#287a54", "role": "Success text, toggles on, step done" },
      "success-bg": { "value": "#eaf5ee", "role": "Trust badge and note backgrounds" },
      "error":      { "value": "#b42318", "role": "Form error text" },
      "favourite":  { "value": "#9d3158", "role": "Active heart icon" },
      "favourite-bg": { "value": "#ffedf2", "role": "Active heart background" }
    },
    "storyArt": {
      "friendship": ["#F6B995", "#694B91"],
      "adventure":  ["#6252A6", "#F2A978"],
      "bedtime":    ["#32306D", "#9F91E9"],
      "indianTales":["#47796B", "#EFBB69"],
      "space":      ["#25285D", "#DB82A6"],
      "festivals":  ["#B15B54", "#F5C568"]
    },
    "illustration": {
      "skin": "#d9986c", "skin-light": "#e8c3a5", "hair": "#332422",
      "child-top": "#6652a1", "elephant": "#8c82a8", "elephant-light": "#9e95b8",
      "elephant-leg": "#81779d", "cricket-bat": "#d9b885", "shirt-gold": "#e2aa55"
    }
  },
  "typography": {
    "families": {
      "body": "DM Sans, sans-serif (400, 500, 600, 700)",
      "display": "Manrope, sans-serif (500, 600, 700, 800) - h1, h2, brand name, top-bar titles, reader paragraphs"
    },
    "source": "https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap",
    "scale": {
      "onboarding-title": "29px / 1.12, letter-spacing -0.8px, Manrope",
      "setup-title": "29px / 1.18, letter-spacing -0.8px",
      "hero-title": "25px / 1.12, letter-spacing -0.7px (22px at <=360px)",
      "home-title": "21px, letter-spacing -0.5px",
      "topbar-title": "17px, weight 800",
      "brand-name": "18px, weight 800, letter-spacing -0.5px",
      "body-large": "15px / 1.55",
      "reader-body": "16px / 1.95 (user scalable 0.9em-1.3em)",
      "button": "weight 700",
      "chip": "12px, weight 600",
      "eyebrow": "10px, weight 800, letter-spacing 1.6px, uppercase",
      "hero-kicker": "9px, weight 800, letter-spacing 1.4px",
      "nav-label": "10px, weight 600"
    }
  },
  "radius": { "lg": "24px", "md": "18px", "sm": "13px", "button": "16px", "hero": "26px", "sheet": "32px 32px 0 0", "chip": "20px", "avatar": "15px (large 19px)", "icon-button": "50%" },
  "shadow": {
    "shadow": "0 12px 30px #2318461c",
    "shadow-soft": "0 5px 18px #23184614",
    "primary-button": "0 8px 18px #35256f33",
    "hero": "0 16px 30px #35256f33",
    "app-shell": "0 0 50px #17152f24",
    "create-nav": "0 5px 15px #35256f40"
  },
  "layout": {
    "shell-max-width": "430px (width: min(100%, 430px)), centered",
    "bottom-nav-height": "76px + safe-area-inset-bottom",
    "topbar-height": "68px",
    "content-padding": "6px 20px 28px (16px sides at <=360px)",
    "min-tap-target": "42px icon buttons, 52px buttons",
    "breakpoints": ["max-width: 360px (compact phones)", "min-height: 900px (tall phones)"]
  },
  "motion": {
    "twinkle": "@keyframes twinkle { to { opacity: .3; transform: scale(.8) rotate(12deg) } }, alternate infinite",
    "twinkle-durations": { "onboarding stars": "2.4s", "generating stars": "1.7s (delays .4s/.7s)", "magic-book spark": "1.1s" },
    "button-transition": "transform .18s, background .18s; :active scale(.98)",
    "icon-button-transition": "all .2s",
    "toggle": "all .2s",
    "chevron-rotate": ".2s (more options)",
    "generation-progress-bar": "width .2s linear steps (+4% every 120ms)",
    "reading-progress-bar": "width .3s",
    "reader-font-size": "font-size .2s",
    "player-progress-tick": "+0.25% every 500ms while playing"
  }
}
