<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (:app uses debugImplementation): the release app stays offline
     (docs/security/play-families-compliance.md). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Supplies the App Check debug token from BuildConfig (AppCheckDebugTokenRegistrar). -->
        <service
            android:name="com.google.firebase.components.ComponentDiscoveryService"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.google.firebase.components:com.littlestory.prototype.gemini.AppCheckDebugTokenRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
        </service>
    </application>
</manifest>
