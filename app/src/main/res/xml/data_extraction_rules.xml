<?xml version="1.0" encoding="utf-8"?>
<!--
    LS-126 / threat T-02: child profiles, favourites and progress never leave the device.
    allowBackup="false" stops cloud backup only up to Android 11; on Android 12+ these rules also
    exclude device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
