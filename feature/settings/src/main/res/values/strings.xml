    <string name="language_story_group">STORY LANGUAGE</string>
    <string name="language_fallback_note">If a story is not yet available in the chosen language, it is shown in English.</string>
    <string name="privacy_title">Privacy &amp; parent controls</string>
    <string name="privacy_banner">Everything stays on this device. LittleStory has no account, no ads and no tracking.</string>
    <string name="privacy_group_data">YOUR DATA</string>
    <string name="privacy_stored_title">What we keep</string>
    <string name="privacy_stored_body">Each child’s first name, age, avatar and interests, plus favourites, reading progress, downloads and the stories you create.</string>
    <string name="privacy_shared_title">What leaves the device</string>
    <string name="privacy_shared_body">Nothing. This version does not connect to the internet.</string>
    <string name="privacy_creation_title">Story creation</string>
    <string name="privacy_creation_body">Stories are made on this device from a built-in template; what you type is never sent anywhere.</string>
    <string name="privacy_group_controls">PARENT CONTROLS</string>
    <string name="privacy_delete_title">Delete all data on this device</string>
    <string name="privacy_delete_body">Removes every child profile, favourite, progress, download, created story and setting. The app starts fresh.</string>
    <string name="privacy_delete_action">Delete all data</string>
    <string name="privacy_confirm_title">Delete everything?</string>
    <string name="privacy_confirm_body">This cannot be undone. Profiles, favourites, progress, downloads and created stories will be gone.</string>
    <string name="privacy_confirm_action">Delete</string>
    <string name="privacy_draft_notice">Draft for review: this privacy and safety text has not yet been checked by a legal reviewer and may change before release.</string>
    <string name="privacy_group_safety">FAMILY SAFETY</string>
    <string name="privacy_audience_title">Made for children, with a grown-up</string>
    <string name="privacy_audience_body">LittleStory is for children aged %1$d to %2$d. A parent or guardian sets it up and manages each child’s profile.</string>
    <string name="privacy_no_ads_title">No ads, purchases or tracking</string>
    <string name="privacy_no_ads_body">There is no advertising, no analytics, no advertising ID and no real payment. The subscription screen is only an illustration.</string>
    <string name="privacy_gate_title">Grown-ups-only areas</string>
    <string name="privacy_gate_body">Changing a child’s details, the language, the plan or these privacy settings first asks a question a grown-up can answer.</string>
    <string name="privacy_content_title">Story content</string>
    <string name="privacy_content_body">Library stories are written for young listeners. Stories made on Create are put together on this device from a template, without AI. Please enjoy new stories together with your child.</string>
    <string name="privacy_group_policy">PRIVACY POLICY</string>
    <string name="privacy_policy_children_title">Children’s information</string>
    <string name="privacy_policy_children_body">We do not collect personal information from children. The details a parent enters are kept only in the app’s private storage on this device and are never sent to us or to anyone else.</string>
    <string name="privacy_policy_keep_title">How long it is kept</string>
    <string name="privacy_policy_keep_body">Until you delete it below or uninstall the app. It is left out of cloud backups and transfers to a new device.</string>
    <string name="privacy_policy_rights_title">Your choices</string>
    <string name="privacy_policy_rights_body">You can see and change each child’s details in Manage children, and delete everything on this device at any time.</string>
    <string name="privacy_policy_changes_title">If this changes</string>
    <string name="privacy_policy_changes_body">If a future version connects to the internet or uses AI to write stories, we will update this policy first and ask for a parent’s permission before any child’s information leaves the device.</string>
    <string name="privacy_policy_contact_title">Contact</string>
    <string name="privacy_policy_contact_body">Contact details for privacy questions will be added here before LittleStory is published.</string>
    <string name="help_title">Help &amp; about</string>
    <string name="help_group_questions">QUESTIONS</string>
    <string name="help_q_stories">How are stories made?</string>
    <string name="help_a_stories">Tell us about your child’s day on Create. This version builds the story on the device from a template; narration is simulated.</string>
    <string name="help_q_offline">Can we listen offline?</string>
    <string name="help_a_offline">Yes. All stories are on the device; downloading only adds a story to the Downloaded tab.</string>
    <string name="help_q_language">How do I change the language?</string>
    <string name="help_a_language">Profile → Language preferences. The app and stories can use different languages.</string>
    <string name="help_q_children">How do I add another child?</string>
    <string name="help_a_children">Profile → Manage children → Add a child profile.</string>
    <string name="help_group_about">ABOUT</string>
    <string name="help_version_title">Version</string>
    <string name="help_version_body">%1$s (build %2$d)</string>
